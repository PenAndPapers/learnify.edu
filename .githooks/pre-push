#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GIT_DIR="${ROOT_DIR}/.git"

export COMPOSE_FILE="${ROOT_DIR}/docker-compose.yml"
export COMPOSE_PROJECT_NAME="learnifyedu"

print_banner() {
  echo
  echo "═══════════════════════════════════════════════════════════════"
  echo "  🪝 Learnify.edu — pre-push quality gate (fail-fast)"
  echo "═══════════════════════════════════════════════════════════════"
}

skip_reason=""
if [ -f "${GIT_DIR}/MERGE_HEAD" ]; then
  skip_reason="merge commit in progress"
elif [ -f "${GIT_DIR}/CHERRY_PICK_HEAD" ]; then
  skip_reason="cherry-pick in progress"
elif [ -f "${GIT_DIR}/REBASE_HEAD" ] || [ -f "${GIT_DIR}/rebase-merge" ] || [ -f "${GIT_DIR}/rebase-apply" ]; then
  skip_reason="rebase in progress"
fi

if [ -n "${skip_reason}" ]; then
  print_banner
  echo "  ⏭️  Skipping pre-push hooks (${skip_reason})."
  echo "═══════════════════════════════════════════════════════════════"
  echo
  exit 0
fi

print_banner

# ────────────────────────────────────────────────────────────────
# FRONTEND — full quality gate (no containers required)
# ────────────────────────────────────────────────────────────────
echo
echo "  🎨 Frontend — Full quality gate (format → lint → typecheck → test)"
echo "  ─────────────────────────────────────────────────────────────"

frontend_step_failed=""
frontend_step_cmd=""
frontend_step_exit=0

if ! command -v pnpm >/dev/null 2>&1; then
  echo "  ❌ pnpm not found on PATH. Cannot run frontend gates."
  echo "     Install pnpm, or run:  make frontend-nuxt-install-deps"
  frontend_step_failed="pnpm-missing"
fi

if [ -z "${frontend_step_failed}" ]; then
  echo "  1/4 Prettier format-check (no writes)..."
  frontend_step_cmd="pnpm format:check (in frontend/nuxt4)"
  set +e
  (cd "${ROOT_DIR}/frontend/nuxt4" && pnpm format:check)
  frontend_step_exit=$?
  set -e
  if [ "${frontend_step_exit}" -ne 0 ]; then
    frontend_step_failed="format-check"
  fi
fi

if [ -z "${frontend_step_failed}" ]; then
  echo "  2/4 ESLint (no --fix — errors only)..."
  frontend_step_cmd="pnpm lint (in frontend/nuxt4)"
  set +e
  (cd "${ROOT_DIR}/frontend/nuxt4" && pnpm lint)
  frontend_step_exit=$?
  set -e
  if [ "${frontend_step_exit}" -ne 0 ]; then
    frontend_step_failed="lint"
  fi
fi

if [ -z "${frontend_step_failed}" ]; then
  echo "  3/4 TypeScript strict typecheck..."
  frontend_step_cmd="pnpm typecheck (in frontend/nuxt4)"
  set +e
  (cd "${ROOT_DIR}/frontend/nuxt4" && pnpm typecheck)
  frontend_step_exit=$?
  set -e
  if [ "${frontend_step_exit}" -ne 0 ]; then
    frontend_step_failed="typecheck"
  fi
fi

if [ -z "${frontend_step_failed}" ]; then
  echo "  4/4 Vitest full suite (run-once)..."
  frontend_step_cmd="pnpm test (in frontend/nuxt4)"
  set +e
  (cd "${ROOT_DIR}/frontend/nuxt4" && pnpm test)
  frontend_step_exit=$?
  set -e
  if [ "${frontend_step_exit}" -ne 0 ]; then
    frontend_step_failed="test"
  fi
fi

if [ -n "${frontend_step_failed}" ]; then
  echo
  echo "  ❌ Frontend gate FAILED at step: ${frontend_step_failed}"
  echo "     Command:  ${frontend_step_cmd}"
  echo "     Exit code: ${frontend_step_exit}"
  echo
  echo "     Local-repair commands (run from repo root):"
  echo "       make frontend-nuxt-format         # Prettier --write"
  echo "       make frontend-nuxt-lint-fix       # ESLint --fix"
  echo "       make frontend-nuxt-typecheck      # Re-check types"
  echo "       make frontend-nuxt-test           # Re-run Vitest"
  echo "  ⚠️  Bypass (emergencies only):  git push --no-verify"
  echo
  echo "═══════════════════════════════════════════════════════════════"
  exit 1
fi

echo
echo "  ✅ Frontend gate: all 4 steps passed."

# ────────────────────────────────────────────────────────────────
# BACKEND — full quality gate (requires running api container)
# ────────────────────────────────────────────────────────────────
echo
echo "  🚀 Backend — Full quality gate (lint → pytest)"
echo "  ─────────────────────────────────────────────────────────────"

backend_container_up=0
backend_container_state=""
if command -v docker >/dev/null 2>&1; then
  backend_container_state="$(cd "${ROOT_DIR}" && docker compose ps api --format '{{.State}}' 2>/dev/null || true)"
  if [ "${backend_container_state}" = "running" ]; then
    backend_container_up=1
  fi
fi

if [ "${backend_container_up}" -ne 1 ]; then
  echo
  echo "  ❌ The 'api' container is NOT running (reported state: '${backend_container_state:-unknown}')."
  echo "     Backend tests require a live Postgres/Redis stack. Push blocked."
  echo
  echo "     👉 Boot the full backend stack (gateway + api + db + cache + mailpit):"
  echo "            make backend-fastapi-up"
  echo "        Then re-run:  git push"
  echo
  echo "     👉 Verify containers are up:  docker compose -f '${COMPOSE_FILE}' ps"
  echo "        Expected: gateway, api, database, cache, mailpit all 'running'."
  echo
  echo "  ⚠️  Emergency bypass (NOT recommended — CI will still fail):"
  echo "        git push --no-verify"
  echo
  echo "═══════════════════════════════════════════════════════════════"
  exit 1
fi

backend_step_failed=""
backend_step_cmd=""
backend_step_exit=0

echo "  1/2 Ruff lint (check-only — no auto-fix at push time)..."
backend_step_cmd="make lint (in backend/fastapi) → docker compose exec api ruff check ..."
set +e
(cd "${ROOT_DIR}/backend/fastapi" && make lint)
backend_step_exit=$?
set -e
if [ "${backend_step_exit}" -ne 0 ]; then
  backend_step_failed="lint"
fi

if [ -z "${backend_step_failed}" ]; then
  echo "  2/2 Pytest full suite (unit + integration + e2e inside api container)..."
  backend_step_cmd="make test (in backend/fastapi) → docker compose exec api pytest --no-cov"
  set +e
  (cd "${ROOT_DIR}/backend/fastapi" && make test)
  backend_step_exit=$?
  set -e
  if [ "${backend_step_exit}" -ne 0 ]; then
    backend_step_failed="test"
  fi
fi

if [ -n "${backend_step_failed}" ]; then
  echo
  echo "  ❌ Backend gate FAILED at step: ${backend_step_failed}"
  echo "     Command:  ${backend_step_cmd}"
  echo "     Exit code: ${backend_step_exit}"
  echo
  echo "     Local-repair commands (run from repo root):"
  echo "       make backend-fastapi-lint    # ruff check --fix + format + lint"
  echo "       make backend-fastapi-test    # full pytest suite"
  echo "  ⚠️  Bypass (emergencies only):  git push --no-verify"
  echo
  echo "═══════════════════════════════════════════════════════════════"
  exit 1
fi

echo
echo "  ✅ Backend gate: both steps passed."

echo
echo "  ✅✅✅ pre-push full quality gate PASSED. Allowing push."
echo "═══════════════════════════════════════════════════════════════"
echo
exit 0
